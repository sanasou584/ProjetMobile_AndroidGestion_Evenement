<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".organizer.AddEventActivity">

    <!-- Header bleu -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_top_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Ajouter un événement"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_profile_circle"
            android:padding="4dp"
            android:src="@drawable/ic_person"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Contenu -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remplissez les informations de l’événement"
                android:textColor="#5F6B7A"
                android:textSize="14sp"
                android:layout_marginBottom="18dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Titre"
                        android:textColor="#24324A"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/txtTitle"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="Ex : Conférence Android"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#1F2937"
                        android:textColorHint="#A0A7B4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Description"
                        android:textColor="#24324A"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/txtdescription"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:gravity="top"
                        android:hint="Décrivez l’événement"
                        android:padding="16dp"
                        android:textColor="#1F2937"
                        android:textColorHint="#A0A7B4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Lieu"
                        android:textColor="#24324A"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/txtlocation"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="Ex : Salle A, Tunis"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#1F2937"
                        android:textColorHint="#A0A7B4" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date"
                                android:textColor="#24324A"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/txtate"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_input"
                                android:focusable="false"
                                android:clickable="true"
                                android:hint="JJ/MM/AAAA"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#1F2937"
                                android:textColorHint="#A0A7B4" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Heure"
                                android:textColor="#24324A"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/txttime"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_input"
                                android:focusable="false"
                                android:clickable="true"
                                android:hint="HH:MM"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#1F2937"
                                android:textColorHint="#A0A7B4" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Capacité"
                        android:textColor="#24324A"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/txtcapacity"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="Ex : 100"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#1F2937"
                        android:textColorHint="#A0A7B4" />

                    <CheckBox
                        android:id="@+id/checkActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Événement actif"
                        android:textColor="#24324A"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnajouterEvent"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_blue"
                android:elevation="4dp"
                android:text="Enregistrer l’événement"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>